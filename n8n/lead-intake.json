      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// One webhook call carries one lead. Clean the fields the rest of the flow relies on.\nconst body = $json.body ?? {};\nconst text = (value) => (typeof value === 'string' ? value.trim() : '');\nconst capitalize = (name) => name.toLowerCase().replace(/(^|[\\s'-])\\p{L}/gu, (m) => m.toUpperCase());\n\nconst email = text(body.email).toLowerCase();\nconst firstName = capitalize(text(body.first_name));\nconst lastName = capitalize(text(body.last_name));\nconst website = text(body.website);\nconst siteDomain = website.toLowerCase().replace(/^https?:\\/\\//, '').replace(/^www\\./, '').split(/[/?#]/)[0];\nconst emailOk = /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nreturn {\n  json: {\n    submission_id: text(body.submission_id) || $execution.id,\n    received_at: new Date().toISOString(),\n    first_name: firstName,\n    last_name: lastName,\n    email,\n    phone: text(body.phone).replace(/\\D/g, ''),\n    company: text(body.company),\n    website,\n    domain: siteDomain || (emailOk ? email.split('@')[1] : ''),\n    job_title: text(body.job_title),\n    company_size: text(body.company_size),\n    country: text(body.country),\n    message: text(body.message),\n    submitted_at: text(body.submitted_at),\n    is_junk: !emailOk || !(firstName || lastName),\n  },\n};\n"
      }
    },
