    {
      "id": "1500fd8a-b2cb-5790-9500-3c646796370d",
      "name": "Score lead",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        300
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: '{{LLM_MODEL}}', max_tokens: 300, system: \"You score inbound leads for Fieldnote, a SaaS that construction companies use to track projects: daily logs, site photos and punch lists. The ideal customer is a builder or contractor with 51 or more employees, and the sender is an owner, director, operations manager or project manager.\\n\\nPick one intent: demo_request, pricing, support_existing_customer, partnership, job_seeker or spam.\\n\\nScore from 0 to 100 and set the tier from the score: hot is 70 to 100, warm is 40 to 69, cold is 0 to 39. A demo or pricing request from a decision maker at a company with 51 or more employees is hot. A demo or pricing request from anyone else is warm. Support requests and partnership offers are warm at 51 or more employees and cold below that. Job seekers and spam are cold.\\n\\nWrite the reason as one short sentence. Always answer by calling record_score.\", tools: [{\"name\": \"record_score\", \"description\": \"Record the score, tier, intent and a one sentence reason for this lead.\", \"input_schema\": {\"type\": \"object\", \"properties\": {\"score\": {\"type\": \"integer\", \"minimum\": 0, \"maximum\": 100}, \"tier\": {\"type\": \"string\", \"enum\": [\"hot\", \"warm\", \"cold\"]}, \"intent\": {\"type\": \"string\", \"enum\": [\"demo_request\", \"pricing\", \"support_existing_customer\", \"partnership\", \"job_seeker\", \"spam\"]}, \"reason\": {\"type\": \"string\", \"maxLength\": 160} }, \"required\": [\"score\", \"tier\", \"intent\", \"reason\"]} }], tool_choice: { type: 'tool', name: 'record_score' }, messages: [{ role: 'user', content: ['Name: ' + $('Normalize').first().json.first_name + ' ' + $('Normalize').first().json.last_name, 'Job title: ' + $('Normalize').first().json.job_title, 'Company: ' + $('Normalize').first().json.company + ' (' + $('Normalize').first().json.company_size + ' employees)', 'Country: ' + $('Normalize').first().json.country, 'Website: ' + $('Normalize').first().json.website, 'Message: ' + $('Normalize').first().json.message].join('\\n') }] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "{{CRED_ANTHROPIC}}",
          "name": "portfolio lead-routing Anthropic"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 1000,
      "onError": "continueErrorOutput"
    },
    {
      "id": "b3005a49-6ca7-5f35-913c-b095491080ae",
      "name": "Parse score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        240
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Keep the AI answer only if every field is valid. Otherwise Rule score takes over.\nconst INTENTS = [\"demo_request\", \"pricing\", \"support_existing_customer\", \"partnership\", \"job_seeker\", \"spam\"];\nconst tierFor = (score) => (score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold');\nconst call = ($json.content ?? []).find((b) => b.type === 'tool_use' && b.name === 'record_score');\nconst s = call?.input ?? {};\nconst ok =\n  Number.isInteger(s.score) && s.score >= 0 && s.score <= 100 &&\n  s.tier === tierFor(s.score) &&\n  INTENTS.includes(s.intent) &&\n  typeof s.reason === 'string' && s.reason.trim() !== '';\n\nif (!ok) {\n  return { json: { score_source: null, problem: call ? 'bad values: ' + JSON.stringify(s) : 'no record_score call' } };\n}\nreturn { json: { score: s.score, tier: s.tier, intent: s.intent, reason: s.reason.trim().slice(0, 160), score_source: 'llm' } };\n"
      }
    },
    {
      "id": "a51d27a4-d8eb-5b6a-b55e-bd75da92e810",
      "name": "Rule score",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Plan B when the AI call fails or its answer is unusable: a fixed rule on title, size and message words.\nif ($json.score_source === 'llm') {\n  return { json: $json };\n}\nconst lead = $('Normalize').first().json;\nconst text = lead.message.toLowerCase();\nconst has = (...words) => words.some((w) => text.includes(w));\n\nlet intent = 'demo_request';\nif (has('seo', 'backlink', 'guest post', 'email list', 'click to claim', 'free audit')) intent = 'spam';\nelse if (has('hiring', 'open role', ' cv', 'resume', 'internship', 'join the')) intent = 'job_seeker';\nelse if (has('partner', 'integration', 'resell', 'referral', 'co-marketing')) intent = 'partnership';\nelse if (has('price', 'pricing', 'cost', 'quote', 'plans', 'budget')) intent = 'pricing';\nelse if (has('already on', 'stopped', \"can't\", 'reset', 'export', 'how do i', 'bug')) intent = 'support_existing_customer';\n\nconst big = ['51-200', '201-1000', '1000+'].includes(lead.company_size);\nconst decisionMaker = /owner|director|operations manager|project manager/i.test(lead.job_title);\n\nlet score = 10;\nif (intent === 'demo_request' || intent === 'pricing') score = decisionMaker && big ? 80 : 55;\nelse if (intent === 'support_existing_customer' || intent === 'partnership') score = big ? 45 : 25;\nconst tier = score >= 70 ? 'hot' : score >= 40 ? 'warm' : 'cold';\n\nconst who = decisionMaker ? 'decision maker' : 'other role';\nconst size = lead.company_size || 'unknown size';\nreturn {\n  json: { score, tier, intent, reason: `Rule: ${intent.replace(/_/g, ' ')}, ${who}, ${size}.`, score_source: 'rule' },\n};\n"
      }
    },
